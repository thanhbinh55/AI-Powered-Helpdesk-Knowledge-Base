# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (AI-Powered Helpdesk & Knowledge Base)
# Sao chép file này thành .env và điền các giá trị thực tế trên máy cá nhân.
# TUYỆT ĐỐI KHÔNG commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# Database Configuration (PostgreSQL / pgvector)
# Khuyến nghị dùng Supabase Cloud (Region Singapore ap-southeast-1) để cả nhóm dùng chung:
# Format Direct: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Format Pooler (IPv4): jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password_here

# Hoặc nếu chạy PostgreSQL local qua Docker Compose (Offline dev fallback):
# DB_URL=jdbc:postgresql://localhost:5432/helpdesk_db
# DB_USERNAME=helpdesk_user
# DB_PASSWORD=your_secure_db_password_here

# Security & Authentication (JWT Secret key >= 256 bits)
JWT_SECRET=your_jwt_secret_token_placeholder_min_256_bits_length

# AI Service Configuration
AI_PROVIDER_KEY=your_ai_provider_api_key_here
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_MODE=mock

# Jira Cloud Integration Configuration (Dùng cho script bulk create task)
JIRA_BASE=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@domain.com
JIRA_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT=SCRUM
