# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (AI-Powered Helpdesk & Knowledge Base)
# Sao chép file này thành .env và điền các giá trị thực tế trên máy cá nhân.
# TUYỆT ĐỐI KHÔNG commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# Database Configuration (PostgreSQL / pgvector)
DB_URL=jdbc:postgresql://localhost:5432/helpdesk_db
DB_USERNAME=helpdesk_user
DB_PASSWORD=your_secure_db_password_here

# Security & Authentication (JWT Secret key >= 256 bits)
JWT_SECRET=your_jwt_secret_token_placeholder_min_256_bits_length

# AI Service Configuration
AI_PROVIDER_KEY=your_ai_provider_api_key_here
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_MODE=mock

# Jira Cloud Integration Configuration (Dùng cho script bulk create task)
JIRA_BASE=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@domain.com
JIRA_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT=SCRUM
