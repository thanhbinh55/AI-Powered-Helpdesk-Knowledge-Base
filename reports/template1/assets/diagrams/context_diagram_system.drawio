        <!-- Central System Boundary -->
        <mxCell id="sys-box" value="&lt;b style=&quot;font-size:15px&quot;&gt;AI-Powered Helpdesk &amp;amp; Knowledge Base System&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Thành phần nội bộ trong ranh giới hệ thống:&lt;/b&gt;&lt;br&gt;• Web Application (React + TypeScript + Tailwind CSS)&lt;br&gt;• Backend API (Spring Boot 3 — Modular Monolith)&lt;br&gt;• Background Ingestion Worker (Trích xuất &amp;amp; Chia đoạn)&lt;br&gt;• CSDL PostgreSQL + pgvector (Lưu dữ liệu &amp;amp; Embeddings)&lt;br&gt;• Private File Storage (Lưu trữ tệp tài liệu nội bộ)" style="shape=rect;html=1;verticalAlign=middle;whiteSpace=wrap;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="420" height="340" as="geometry" />
